{
  "name": "curiosamente-app",
  "version": "1.5.0",
  "description": "App de escritorio de gestión de alumnos y recibos para Academia Curiosamente",
  "main": "main.js",
  "scripts": {
    "build": "esbuild src/app.js --bundle --outfile=app/bundle.js --format=iife --platform=browser",
    "start": "npm run build && electron .",
    "test": "node test/test-pdf.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "release": "npm run build && electron-builder --win --publish always"
  },
  "author": "Academia Curiosamente",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.8.9",
    "pdf-lib": "^1.17.1"
  },
  "build": {
    "appId": "com.curiosamente.gestion",
    "productName": "Curiosamente",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "afterSign": "scripts/afterSignMac.cjs",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "config.defaults.json",
      "app/**/*",
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "adriaan10",
      "repo": "curiosamente-academia"
    }
  }
}
